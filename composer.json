{
    "name": "edyjen/pecle-search",
    "description": "Buscador por palabras para Laravel con corrección silenciosa de errores de tecleo y autocompletado.",
    "keywords": ["laravel", "search", "typo", "autocomplete", "spanish"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.1"
    },
    "autoload": {
        "psr-4": {
            "Pecle\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pecle\\Search\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pecle\\Search\\Laravel\\PecleSearchServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
